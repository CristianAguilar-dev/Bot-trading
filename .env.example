# ==========================================
# CONFIGURACIÓN DEL BOT DE TRADING CRYPTO
# ==========================================

# Modo de operación: "paper" (simulación virtual sin dinero real) o "live" (dinero real / testnet)
BOT_MODE=paper

# Exchange: binance, bybit, kucoin, kraken, okx, etc.
EXCHANGE_ID=binance

# ¿Usar Testnet oficial del exchange? (true/false)
USE_TESTNET=true

# Claves API del Exchange (Solo necesarias si BOT_MODE=live o para Testnet real)
API_KEY=tu_api_key_aqui
API_SECRET=tu_api_secret_aqui

# Par y Temporalidad
SYMBOL=BTC/USDT
TIMEFRAME=1h

# Estrategia: Medias Móviles Exponenciales (EMA)
FAST_EMA=9
SLOW_EMA=21

# Filtro de Fuerza / Momentum (RSI)
RSI_PERIOD=14
RSI_BUY_THRESHOLD=50
RSI_OVERBOUGHT=70
RSI_OVERSOLD=30

# Gestión de Riesgo (en porcentaje %)
TAKE_PROFIT_PCT=3.0
STOP_LOSS_PCT=1.5
TRAILING_STOP=false
MAX_POSITION_PCT=25.0

# Simulación / Paper Trading
INITIAL_BALANCE=1000.0

# Notificaciones opcionales vía Telegram (dejar vacío si no se desea usar)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
